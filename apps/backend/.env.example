# Base de datos (desarrollo local: docker compose up -d en la raíz, puerto 5435)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/invoiceapp
DIRECT_URL=postgresql://postgres:postgres@localhost:5435/invoiceapp

# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=https://invoiceapp.gargurevich.com
# Orígenes extra permitidos por CORS, separados por comas (opcional)
CORS_ORIGINS=

# JWT
JWT_SECRET=tu_secreto_jwt_muy_largo_y_seguro

# Resend Email API
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@gargurevich.com
RESEND_FROM_NAME=Facturo

# Stripe - Subscription Payments
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# SUNAT (Perú) — llave maestra de 32 bytes en base64: openssl rand -base64 32
SUNAT_MASTER_KEY=

# Bucket R2 privado para XML/CDR de SUNAT (sin acceso público)
R2_PRIVATE_BUCKET=

# Motor SUNAT (apps/sunat-engine), solo en red interna
SUNAT_ENGINE_URL=
SUNAT_ENGINE_TOKEN=

# Solo desarrollo: guarda XML/CDR de SUNAT en esta carpeta en lugar de R2 (prohibido con NODE_ENV=production)
SUNAT_ALMACEN_DIR=

# Almacenamiento de archivos: "local" (disco del backend, desarrollo) o "r2" (Cloudflare R2, producción)
STORAGE_PROVIDER=local
# Carpeta del proveedor local, relativa al directorio de trabajo del backend (se sirve en /uploads)
LOCAL_UPLOADS_DIR=uploads
# URL pública del backend para los enlaces a /uploads (por defecto http://localhost:PORT)
PUBLIC_BACKEND_URL=http://localhost:4000

# Solo si STORAGE_PROVIDER=r2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
R2_PATH_STYLE=false

# Culqi (pagos de Perú). Llaves de prueba en CulqiPanel › Desarrollo › API Keys. La sk NUNCA va al frontend.
CULQI_SECRET_KEY=
