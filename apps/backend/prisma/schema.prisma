// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums for Digital Signature System
enum DocumentType {
  INVOICE
  PROFORMA
}

enum SignatureRequestStatus {
  PENDING
  SIGNED
  EXPIRED
  CANCELLED
}

// User roles for admin system
enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

// Subscription System Enums
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  INCOMPLETE
}

enum BillingInterval {
  MONTH
  YEAR
}

// 👤 Application User Profile (local JWT auth)
model UserProfile {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String?   @map("password_hash")
  name         String?
  role         UserRole  @default(USER)
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  empresa      Empresa?

  @@map("user_profiles")
}

// 🏢 Empresa/Organización del usuario
model Empresa {
  id              String    @id @default(uuid())
  nombre          String
  razonSocial     String?   @map("razon_social")
  nombreComercial String?   @map("nombre_comercial")
  ruc             String    @unique
  direccion       String?
  telefono        String?
  email           String?
  web             String?
  logoUrl         String?   @map("logo_url")
  firmaEmpresa    String?   @map("firma_empresa") @db.Text // Digital signature of the company for proposals
  licencia        String?   // License number (contractor license, etc.)
  tituloProfesional String? @map("titulo_profesional") // Professional title (e.g., "MASTER ELECTRICIAN")
  moneda          String    @default("PEN")
  currency        String    @default("USD") // Currency code (USD, EUR, PEN, etc.)
  locale          String    @default("en") // Locale for formatting (en, es)
  taxRate         Decimal   @default(18) @map("tax_rate") @db.Decimal(5, 2) // Tax rate percentage (e.g., 18 for 18%, 10 for 10%)
  taxName         String    @default("Tax") @map("tax_name") // Tax name (VAT, IGV, IVA, etc.)
  serieFactura    String    @default("F001") @map("serie_factura")
  serieProforma   String    @default("P001") @map("serie_proforma")
  setupCompleted  Boolean   @default(false) @map("setup_completed") // Whether user completed onboarding wizard
  pais            String    @default("US") // "US" | "PE": "PE" activa la facturación electrónica SUNAT
  colorPrimario   String?   @map("color_primario") // Color de marca «#RRGGBB» (null = berenjena de Facturo). Plan con hasCustomBranding
  userId          String    @unique @map("user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  user            UserProfile? @relation(fields: [userId], references: [id])
  clientes        Cliente[]
  productos       Producto[]
  facturas        Factura[]
  proformas       Proforma[]
  signatureRequests SignatureRequest[]
  subscription    Subscription?
  emisorSunat     EmisorSunat?
  procesosSunat   ProcesoSunat[]
  
  @@index([userId], map: "idx_empresa_user_id")
  @@map("empresas")
}

// 👥 Clientes
model Cliente {
  id              String    @id @default(uuid())
  empresaId       String    @map("empresa_id")
  tipoDocumento   String    @map("tipo_documento") // RUC, DNI, CE
  numeroDocumento String?   @map("numero_documento")
  razonSocial     String    @map("razon_social")
  nombreComercial String?   @map("nombre_comercial")
  direccion       String?
  email           String?
  telefono        String?
  contacto        String?   // Persona de contacto
  notas           String?
  activo          Boolean   @default(true)
  esAgenteRetencion Boolean @default(false) @map("es_agente_retencion")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  empresa         Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  facturas        Factura[]
  proformas       Proforma[]
  
  @@index([empresaId], map: "idx_cliente_empresa_id")
  @@index([numeroDocumento], map: "idx_cliente_documento")
  @@map("clientes")
}

// 📦 Productos/Servicios
model Producto {
  id              String    @id @default(uuid())
  empresaId       String    @map("empresa_id")
  codigo          String?
  nombre          String
  descripcion     String?
  tipo            String?   // producto, servicio
  unidadMedida    String    @default("UND") @map("unidad_medida")
  precioUnitario  Decimal   @map("precio_unitario") @db.Decimal(10, 2)
  precioConIgv    Boolean   @default(true) @map("precio_con_igv")
  stockActual     Int?      @map("stock_actual")
  stockMinimo     Int?      @map("stock_minimo")
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  empresa         Empresa    @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  detallesFactura DetalleFactura[]
  detallesProforma DetalleProforma[]
  
  @@unique([empresaId, codigo])
  @@index([empresaId], map: "idx_producto_empresa_id")
  @@index([nombre], map: "idx_producto_nombre")
  @@map("productos")
}

// 🧾 Facturas
model Factura {
  id                String    @id @default(uuid())
  empresaId         String    @map("empresa_id")
  clienteId         String    @map("cliente_id")
  serie             String
  numero            Int?      // null mientras es borrador SUNAT; se asigna al emitir
  fechaEmision      DateTime  @map("fecha_emision")
  fechaVencimiento  DateTime? @map("fecha_vencimiento")
  
  // Job information (contractor-specific fields)
  jobName           String?   @map("job_name")
  jobLocation       String?   @map("job_location")
  orderType         String?   @map("order_type") // Day Work, Contract, Extra
  workDescription   String?   @map("work_description") @db.Text
  paymentTerms      String?   @map("payment_terms") @db.Text
  
  // Montos
  subtotal          Decimal   @db.Decimal(10, 2)
  descuento         Decimal   @default(0) @db.Decimal(10, 2)
  igv               Decimal   @db.Decimal(10, 2)
  total             Decimal   @db.Decimal(10, 2)
  totalMaterials    Decimal?  @map("total_materials") @db.Decimal(10, 2)
  totalLabor        Decimal?  @map("total_labor") @db.Decimal(10, 2)
  moneda            String    @default("PEN")
  tipoCambio        Decimal?  @map("tipo_cambio") @db.Decimal(10, 4)
  
  // Estado
  estado            String    @default("emitida") // emitida, pagada, anulada, vencida
  formaPago         String?   @map("forma_pago") // contado, credito_30, credito_60
  observaciones     String?
  
  // SUNAT (opcional para integración futura)
  enviadoSunat      Boolean   @default(false) @map("enviado_sunat")
  cdrSunat          String?   @map("cdr_sunat")
  hashSunat         String?   @map("hash_sunat")
  
  // Archivos adjuntos (almacenamiento: R2 o local)
  pdfUrl            String?   @map("pdf_url")
  xmlUrl            String?   @map("xml_url")
  
  // Facturación electrónica SUNAT (solo empresas con pais = "PE")
  tipoComprobante       String    @default("01") @map("tipo_comprobante")
  tipoOperacion         String    @default("0101") @map("tipo_operacion")
  estadoSunat           String?   @map("estado_sunat")
  totalGravadas         Decimal   @default(0) @map("total_gravadas") @db.Decimal(12, 2)
  totalExoneradas       Decimal   @default(0) @map("total_exoneradas") @db.Decimal(12, 2)
  totalInafectas        Decimal   @default(0) @map("total_inafectas") @db.Decimal(12, 2)
  totalExportacion      Decimal   @default(0) @map("total_exportacion") @db.Decimal(12, 2)
  totalIcbper           Decimal   @default(0) @map("total_icbper") @db.Decimal(12, 2)
  montoEnLetras         String?   @map("monto_en_letras")
  detraccionCodigo      String?   @map("detraccion_codigo")
  detraccionPorcentaje  Decimal?  @map("detraccion_porcentaje") @db.Decimal(5, 2)
  detraccionMonto       Decimal?  @map("detraccion_monto") @db.Decimal(12, 2)
  percepcionRegimen     String?   @map("percepcion_regimen")
  percepcionPorcentaje  Decimal?  @map("percepcion_porcentaje") @db.Decimal(5, 2)
  percepcionBase        Decimal?  @map("percepcion_base") @db.Decimal(12, 2)
  percepcionMonto       Decimal?  @map("percepcion_monto") @db.Decimal(12, 2)
  retencionPorcentaje   Decimal?  @map("retencion_porcentaje") @db.Decimal(5, 2)
  retencionMonto        Decimal?  @map("retencion_monto") @db.Decimal(12, 2)
  netoPendiente         Decimal?  @map("neto_pendiente") @db.Decimal(12, 2)
  docRelacionadoId      String?   @map("doc_relacionado_id")
  docRelacionadoTipo    String?   @map("doc_relacionado_tipo")
  docRelacionadoSerie   String?   @map("doc_relacionado_serie")
  docRelacionadoNumero  Int?      @map("doc_relacionado_numero")
  motivoCodigo          String?   @map("motivo_codigo")
  motivoDescripcion     String?   @map("motivo_descripcion")
  xmlKey                String?   @map("xml_key")
  cdrKey                String?   @map("cdr_key")
  codigoRespuestaSunat  String?   @map("codigo_respuesta_sunat")
  mensajeRespuestaSunat String?   @map("mensaje_respuesta_sunat") @db.Text
  observacionesSunat    Json?     @map("observaciones_sunat")
  intentosEnvio         Int       @default(0) @map("intentos_envio")
  fechaEnvioSunat       DateTime? @map("fecha_envio_sunat")

  proformaOrigenId  String?   @map("proforma_origen_id")
  userId            String    @map("user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  cliente           Cliente   @relation(fields: [clienteId], references: [id])
  proformaOrigen    Proforma? @relation(fields: [proformaOrigenId], references: [id])
  detalles          DetalleFactura[]
  pagos             PagoFactura[]
  workLogs          WorkLog[]
  jobPhotos         JobPhoto[]
  jobReceipts       JobReceipt[]
  signatureRequests SignatureRequest[]
  cuotas            CuotaFactura[]
  envios            EnvioSunat[]
  procesoItems      ProcesoSunatItem[]
  
  @@unique([empresaId, serie, numero])
  @@index([empresaId], map: "idx_factura_empresa_id")
  @@index([clienteId], map: "idx_factura_cliente_id")
  @@index([fechaEmision(sort: Desc)], map: "idx_factura_fecha")
  @@index([estado], map: "idx_factura_estado")
  @@index([estadoSunat], map: "idx_factura_estado_sunat")
  @@map("facturas")
}

// 📝 Detalle de Factura
model DetalleFactura {
  id              String   @id @default(uuid())
  facturaId       String   @map("factura_id")
  productoId      String?  @map("producto_id")
  descripcion     String
  cantidad        Decimal  @db.Decimal(10, 3)
  unidadMedida    String   @map("unidad_medida")
  precioUnitario  Decimal  @map("precio_unitario") @db.Decimal(10, 4)
  descuento       Decimal  @default(0) @db.Decimal(10, 2)
  subtotal        Decimal  @db.Decimal(10, 2)
  igv             Decimal  @db.Decimal(10, 2)
  total           Decimal  @db.Decimal(10, 2)
  orden           Int      @default(0)
  codigoUnidadSunat    String   @default("NIU") @map("codigo_unidad_sunat")
  tipoAfectacionIgv    String   @default("10") @map("tipo_afectacion_igv")
  precioIncluyeIgv     Boolean  @default(false) @map("precio_incluye_igv")
  valorUnitario        Decimal? @map("valor_unitario") @db.Decimal(22, 10)
  precioUnitarioIgv    Decimal? @map("precio_unitario_igv") @db.Decimal(22, 10)
  icbper               Decimal  @default(0) @db.Decimal(10, 2)
  cantidadBolsasIcbper Int      @default(0) @map("cantidad_bolsas_icbper")
  codigoProductoSunat  String?  @map("codigo_producto_sunat")
  
  factura         Factura   @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  producto        Producto? @relation(fields: [productoId], references: [id])
  
  @@index([facturaId], map: "idx_detalle_factura_id")
  @@map("detalles_factura")
}

// 💵 Pagos de Factura
model PagoFactura {
  id            String   @id @default(uuid())
  facturaId     String   @map("factura_id")
  fecha         DateTime
  monto         Decimal  @db.Decimal(10, 2)
  metodoPago    String   @map("metodo_pago") // efectivo, transferencia, tarjeta, cheque
  referencia    String?  // Número de operación, cheque, etc.
  observaciones String?
  createdAt     DateTime @default(now()) @map("created_at")
  
  factura       Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  
  @@index([facturaId], map: "idx_pago_factura_id")
  @@map("pagos_factura")
}

// 📋 Proformas/Cotizaciones
model Proforma {
  id                String    @id @default(uuid())
  empresaId         String    @map("empresa_id")
  clienteId         String    @map("cliente_id")
  serie             String
  numero            Int
  fechaEmision      DateTime  @map("fecha_emision")
  fechaValidez      DateTime? @map("fecha_validez")
  
  // Job information (contractor-specific fields)
  jobName           String?   @map("job_name")
  jobLocation       String?   @map("job_location")
  orderType         String?   @map("order_type") // Day Work, Contract, Extra
  workDescription   String?   @map("work_description") @db.Text
  paymentTerms      String?   @map("payment_terms") @db.Text
  
  // Additional contractor fields (Proposal template)
  arquitectoNombre  String?   @map("arquitecto_nombre")
  fechaPlanos       DateTime? @map("fecha_planos")
  telefonoTrabajo   String?   @map("telefono_trabajo")
  firmaAutorizada   String?   @map("firma_autorizada") @db.Text
  diasValidez       Int?      @map("dias_validez")
  firmaAceptacion   String?   @map("firma_aceptacion") @db.Text
  fechaAceptacion   DateTime? @map("fecha_aceptacion")
  
  // Montos
  subtotal          Decimal   @db.Decimal(10, 2)
  descuento         Decimal   @default(0) @db.Decimal(10, 2)
  igv               Decimal   @db.Decimal(10, 2)
  total             Decimal   @db.Decimal(10, 2)
  totalMaterials    Decimal?  @map("total_materials") @db.Decimal(10, 2)
  totalLabor        Decimal?  @map("total_labor") @db.Decimal(10, 2)
  moneda            String    @default("PEN")
  tipoCambio        Decimal?  @map("tipo_cambio") @db.Decimal(10, 4)
  
  // Estado
  estado            String    @default("pendiente") // pendiente, aceptada, rechazada, vencida, facturada
  condiciones       String?   @db.Text // Terms and conditions (large text for templates)
  observaciones     String?   @db.Text
  
  // Archivos (almacenamiento: R2 o local)
  pdfUrl            String?   @map("pdf_url")
  
  userId            String    @map("user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  cliente           Cliente   @relation(fields: [clienteId], references: [id])
  detalles          DetalleProforma[]
  facturasGeneradas Factura[]
  workLogs          WorkLog[]
  jobPhotos         JobPhoto[]
  signatureRequests SignatureRequest[]
  jobReceipts       JobReceipt[]
  
  @@unique([empresaId, serie, numero])
  @@index([empresaId], map: "idx_proforma_empresa_id")
  @@index([clienteId], map: "idx_proforma_cliente_id")
  @@index([fechaEmision(sort: Desc)], map: "idx_proforma_fecha")
  @@index([estado], map: "idx_proforma_estado")
  @@map("proformas")
}

// 📝 Detalle de Proforma
model DetalleProforma {
  id              String    @id @default(uuid())
  proformaId      String    @map("proforma_id")
  productoId      String?   @map("producto_id")
  descripcion     String
  cantidad        Decimal   @db.Decimal(10, 3)
  unidadMedida    String    @map("unidad_medida")
  precioUnitario  Decimal   @map("precio_unitario") @db.Decimal(10, 4)
  descuento       Decimal   @default(0) @db.Decimal(10, 2)
  subtotal        Decimal   @db.Decimal(10, 2)
  igv             Decimal   @db.Decimal(10, 2)
  total           Decimal   @db.Decimal(10, 2)
  orden           Int       @default(0)
  
  proforma        Proforma  @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  producto        Producto? @relation(fields: [productoId], references: [id])
  
  @@index([proformaId], map: "idx_detalle_proforma_id")
  @@map("detalles_proforma")
}

// 📊 Configuración de numeración
model ConfiguracionSeries {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  tipoDocumento   String   @map("tipo_documento") // factura, proforma, boleta
  serie           String
  ultimoNumero    Int      @default(0) @map("ultimo_numero")
  activa          Boolean  @default(true)
  
  @@unique([empresaId, tipoDocumento, serie])
  @@map("configuracion_series")
}

// 📝 Work Log / Bitácora de Trabajo
model WorkLog {
  id              String    @id @default(uuid())
  facturaId       String?   @map("factura_id")
  proformaId      String?   @map("proforma_id")
  fecha           DateTime
  descripcion     String    @db.Text
  horasTrabajadas Decimal?  @map("horas_trabajadas") @db.Decimal(5, 2)
  trabajador      String?   // Nombre del trabajador/técnico
  observaciones   String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  factura         Factura?  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  proforma        Proforma? @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  
  @@index([facturaId], map: "idx_work_log_factura")
  @@index([proformaId], map: "idx_work_log_proforma")
  @@index([fecha(sort: Desc)], map: "idx_work_log_fecha")
  @@map("work_logs")
}

// 📸 Job Photos - Fotos del trabajo
model JobPhoto {
  id              String    @id @default(uuid())
  facturaId       String?   @map("factura_id")
  proformaId      String?   @map("proforma_id")
  url             String    // URL en el almacenamiento (R2 o local)
  descripcion     String?
  fecha           DateTime  @default(now())
  orden           Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at")
  
  factura         Factura?  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  proforma        Proforma? @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  
  @@index([facturaId], map: "idx_job_photo_factura")
  @@index([proformaId], map: "idx_job_photo_proforma")
  @@map("job_photos")
}

// 🧾 Job Receipts - Recibos/Gastos del trabajo
model JobReceipt {
  id              String    @id @default(uuid())
  facturaId       String?   @map("factura_id")
  proformaId      String?   @map("proforma_id")
  fecha           DateTime
  descripcion     String
  monto           Decimal   @db.Decimal(10, 2)
  categoria       String?   // materiales, mano_obra, transporte, otros
  proveedor       String?
  numeroRecibo    String?   @map("numero_recibo")
  url             String?   // PDF o foto del recibo
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  factura         Factura?  @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  proforma        Proforma? @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  
  @@index([facturaId], map: "idx_job_receipt_factura")
  @@index([proformaId], map: "idx_job_receipt_proforma")
  @@index([fecha(sort: Desc)], map: "idx_job_receipt_fecha")
  @@map("job_receipts")
}

// 📝 Digital Signature System
// Signature Requests - Tracks requests for digital signatures
model SignatureRequest {
  id              String                   @id @default(uuid())
  token           String                   @unique // Secure single-use token
  documentType    DocumentType             @map("document_type") // 'INVOICE' or 'PROFORMA'
  documentId      String                   @map("document_id") // ID de la factura o proforma (sin relación: ver facturaId/proformaId)
  facturaId       String?                  @map("factura_id") // Se llena si documentType = INVOICE
  proformaId      String?                  @map("proforma_id") // Se llena si documentType = PROFORMA
  signerEmail     String                   @map("signer_email")
  signerName      String?                  @map("signer_name")
  status          SignatureRequestStatus   @default(PENDING) // PENDING, ACCEPTED, EXPIRED, CANCELLED
  expiresAt       DateTime                 @map("expires_at")
  
  // Metadata
  requestedBy     String    @map("requested_by") // User ID who requested
  empresaId       String    @map("empresa_id")
  
  // Timestamps
  createdAt       DateTime  @default(now()) @map("created_at")
  sentAt          DateTime? @map("sent_at")
  viewedAt        DateTime? @map("viewed_at")
  
  // Relations
  empresa         Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  factura         Factura?  @relation(fields: [facturaId], references: [id], onDelete: Cascade, map: "fk_signature_request_factura_id")
  proforma        Proforma? @relation(fields: [proformaId], references: [id], onDelete: Cascade, map: "fk_signature_request_proforma_id")
  signature       Signature?

  @@index([token])
  @@index([documentId])
  @@index([facturaId], map: "idx_signature_request_factura_id")
  @@index([proformaId], map: "idx_signature_request_proforma_id")
  @@index([status])
  @@index([expiresAt])
  @@map("signature_requests")
}

// ✍️ Signatures - Stores completed signatures with full audit trail
model Signature {
  id                    String    @id @default(uuid())
  signatureRequestId    String    @unique @map("signature_request_id")
  
  // Signature data
  signatureImageUrl     String    @map("signature_image_url") // Ruta en el almacenamiento (R2 o local)
  signedPdfUrl          String?   @map("signed_pdf_url") // Final signed PDF
  documentHash          String?   @map("document_hash") // SHA-256 hash of signed PDF for immutability verification
  
  // Signer information
  signerName            String    @map("signer_name")
  signerEmail           String    @map("signer_email")
  signedAt              DateTime  @default(now()) @map("signed_at")
  
  // Legal compliance
  consentGiven          Boolean   @default(true) @map("consent_given")
  consentText           String?   @map("consent_text")
  
  // Audit metadata (captured server-side for security)
  ipAddress             String    @map("ip_address") // IP address of signer
  userAgent             String    @map("user_agent") // Browser/device info
  deviceType            String?   @map("device_type") // 'mobile', 'tablet', 'desktop'
  
  // Timestamps
  createdAt             DateTime  @default(now()) @map("created_at")
  
  // Relations
  signatureRequest      SignatureRequest @relation(fields: [signatureRequestId], references: [id], onDelete: Cascade)
  
  @@index([signatureRequestId])
  @@index([documentHash])
  @@map("signatures")
}

// 🎨 User Preferences
model UserPreferences {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  
  // Appearance settings
  theme       String   @default("light") // light, dark
  fontSize    String   @default("small") @map("font_size") // small, medium, large
  locale      String   @default("en") // es, en
  
  // Notification settings
  emailFactura          Boolean  @default(true) @map("email_factura")
  emailVencimiento      Boolean  @default(true) @map("email_vencimiento")
  emailPago             Boolean  @default(true) @map("email_pago")
  diasAntesVencimiento  Int      @default(5) @map("dias_antes_vencimiento")
  
  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("user_preferences")
}

// 💳 Subscription Plans
model Plan {
  id              String   @id @default(uuid())
  name            String
  slug            String   @unique
  description     String?
  
  // Pricing
  priceMonthly    Decimal  @map("price_monthly") @db.Decimal(10, 2)
  priceYearly     Decimal  @map("price_yearly") @db.Decimal(10, 2)
  currency        String   @default("USD")
  pais            String   @default("US") // "US" | "PE"

  // Stripe IDs
  stripePriceIdMonthly String? @map("stripe_price_id_monthly")
  stripePriceIdYearly  String? @map("stripe_price_id_yearly")
  stripeProductId      String? @map("stripe_product_id")

  // Culqi (planes de Perú)
  culqiPlanIdMensual String? @map("culqi_plan_id_mensual")
  culqiPlanIdAnual   String? @map("culqi_plan_id_anual")
  
  // Limits (-1 means unlimited)
  maxInvoicesPerMonth   Int     @default(-1) @map("max_invoices_per_month")
  maxClients            Int     @default(-1) @map("max_clients")
  maxProposalsPerMonth  Int     @default(-1) @map("max_proposals_per_month")
  maxStorageMb          Int     @default(100) @map("max_storage_mb")
  
  // Features
  hasProposals          Boolean @default(false) @map("has_proposals")
  hasDigitalSignatures  Boolean @default(false) @map("has_digital_signatures")
  hasReports            Boolean @default(false) @map("has_reports")
  hasCustomBranding     Boolean @default(false) @map("has_custom_branding")
  hasMultiCurrency      Boolean @default(false) @map("has_multi_currency")
  hasJobTracking        Boolean @default(false) @map("has_job_tracking")
  hasAdvancedReports    Boolean @default(false) @map("has_advanced_reports")
  hasPrioritySupport    Boolean @default(false) @map("has_priority_support")
  hasApiAccess          Boolean @default(false) @map("has_api_access")
  hasRegimenesSunat     Boolean @default(false) @map("has_regimenes_sunat") // detracción y percepción
  
  // Metadata
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  isPopular     Boolean  @default(false) @map("is_popular")
  trialDays     Int      @default(14) @map("trial_days")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  subscriptions Subscription[]
  
  @@map("plans")
}

// 📋 Company Subscriptions
model Subscription {
  id              String             @id @default(uuid())
  empresaId       String             @unique @map("empresa_id")
  planId          String             @map("plan_id")
  
  // Status
  status          SubscriptionStatus @default(TRIALING)
  billingInterval BillingInterval    @default(MONTH) @map("billing_interval")
  
  // Stripe
  stripeCustomerId      String? @unique @map("stripe_customer_id")
  stripeSubscriptionId  String? @unique @map("stripe_subscription_id")

  // Proveedor de pago: "stripe" (EE. UU.) | "culqi" (Perú)
  proveedorPago         String  @default("stripe") @map("proveedor_pago")
  culqiCustomerId       String? @map("culqi_customer_id")
  culqiCardId           String? @map("culqi_card_id")
  culqiSubscriptionId   String? @unique @map("culqi_subscription_id")
  
  // Dates
  trialStart          DateTime? @map("trial_start")
  trialEnd            DateTime? @map("trial_end")
  currentPeriodStart  DateTime? @map("current_period_start")
  currentPeriodEnd    DateTime? @map("current_period_end")
  canceledAt          DateTime? @map("canceled_at")
  cancelAtPeriodEnd   Boolean   @default(false) @map("cancel_at_period_end")
  
  // Usage tracking
  invoicesUsed  Int @default(0) @map("invoices_used")
  proposalsUsed Int @default(0) @map("proposals_used")
  storageUsedMb Int @default(0) @map("storage_used_mb")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  plan    Plan    @relation(fields: [planId], references: [id])
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  
  @@index([stripeCustomerId])
  @@index([status])
  @@map("subscriptions")
}

// 📊 Usage Events (for tracking and analytics)
model UsageEvent {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  eventType String   @map("event_type") // 'invoice_created', 'proposal_created', 'storage_updated'
  quantity  Int      @default(1)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  
  @@index([empresaId])
  @@index([eventType])
  @@index([createdAt])
  @@map("usage_events")
}

// Eventos de Culqi ya procesados (idempotencia del webhook)
model EventoCulqi {
  id          String   @id // evt_test_… / evt_live_…
  tipo        String
  procesadoEn DateTime @default(now()) @map("procesado_en")

  @@map("eventos_culqi")
}

// 🇵🇪 Emisor SUNAT (1:1 con la empresa). Los secretos van cifrados (src/sunat/seguridad/cifrado.js).
model EmisorSunat {
  id                      String    @id @default(uuid())
  empresaId               String    @unique @map("empresa_id")
  ubigeo                  String
  departamento            String
  provincia               String
  distrito                String
  urbanizacion            String?
  direccionFiscal         String    @map("direccion_fiscal")
  codigoEstablecimiento   String    @default("0000") @map("codigo_establecimiento")
  ambiente                String    @default("BETA") // BETA | PRODUCCION
  solUsuario              String?   @map("sol_usuario")
  solClaveCifrada         String?   @map("sol_clave_cifrada") @db.Text
  certificadoCifrado      String?   @map("certificado_cifrado") @db.Text
  certificadoClaveCifrada String?   @map("certificado_clave_cifrada") @db.Text
  certificadoVence        DateTime? @map("certificado_vence")
  cuentaDetracciones      String?   @map("cuenta_detracciones")
  esAgenteRetencion       Boolean   @default(false) @map("es_agente_retencion")
  esAgentePercepcion      Boolean   @default(false) @map("es_agente_percepcion")
  greClientId             String?   @map("gre_client_id") // subproyecto 3 (guías)
  greSecretCifrado        String?   @map("gre_secret_cifrado") @db.Text
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  empresa                 Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("emisores_sunat")
}

model CuotaFactura {
  id               String   @id @default(uuid())
  facturaId        String   @map("factura_id")
  numero           Int
  monto            Decimal  @db.Decimal(12, 2)
  fechaVencimiento DateTime @map("fecha_vencimiento")

  factura          Factura  @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@unique([facturaId, numero])
  @@map("cuotas_factura")
}

// Resumen diario (RC) y comunicación de baja (RA)
model ProcesoSunat {
  id               String    @id @default(uuid())
  empresaId        String    @map("empresa_id")
  tipo             String    // RC | RA
  fechaGeneracion  DateTime  @map("fecha_generacion") @db.Date
  fechaReferencia  DateTime  @map("fecha_referencia") @db.Date
  correlativo      Int
  ticket           String?
  estado           String    @default("ENVIADO") // ENVIADO | ACEPTADO | RECHAZADO
  xmlKey           String?   @map("xml_key")
  cdrKey           String?   @map("cdr_key")
  codigoRespuesta  String?   @map("codigo_respuesta")
  mensajeRespuesta String?   @map("mensaje_respuesta") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  empresa          Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  items            ProcesoSunatItem[]
  envios           EnvioSunat[]

  @@unique([empresaId, tipo, fechaGeneracion, correlativo])
  @@index([estado])
  @@map("procesos_sunat")
}

model ProcesoSunatItem {
  id           String       @id @default(uuid())
  procesoId    String       @map("proceso_id")
  facturaId    String       @map("factura_id")
  motivo       String?
  estadoPrevio String       @map("estado_previo")

  proceso      ProcesoSunat @relation(fields: [procesoId], references: [id], onDelete: Cascade)
  factura      Factura      @relation(fields: [facturaId], references: [id])

  @@index([facturaId])
  @@map("proceso_sunat_items")
}

// Bitácora de cada intento contra SUNAT
model EnvioSunat {
  id         String        @id @default(uuid())
  facturaId  String?       @map("factura_id")
  procesoId  String?       @map("proceso_id")
  operacion  String        // sendBill | getStatusCdr | getStatus
  codigo     String?
  mensaje    String?       @db.Text
  exito      Boolean
  duracionMs Int           @map("duracion_ms")
  createdAt  DateTime      @default(now()) @map("created_at")

  factura    Factura?      @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  proceso    ProcesoSunat? @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  @@index([facturaId])
  @@index([procesoId])
  @@map("envios_sunat")
}


// 🏛️ Configuración global del sitio (una sola fila, id "global").
// Datos legales de quien presta el servicio: se muestran en Términos, Privacidad, Contacto y el pie.
// Vacío (null) = el sitio muestra «por confirmar». Se edita en Admin › Datos legales (SUPER_ADMIN).
model ConfiguracionSitio {
  id               String   @id @default("global")
  legalMarca       String?  @map("legal_marca")
  legalRazonSocial String?  @map("legal_razon_social")
  legalRuc         String?  @map("legal_ruc")
  legalDomicilio   String?  @map("legal_domicilio")
  legalCorreo      String?  @map("legal_correo")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("configuracion_sitio")
}
